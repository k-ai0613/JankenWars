# Mac / Windows のエディタ設定を揃える
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown は行末スペースが改行の意味を持つため除外
[*.md]
trim_trailing_whitespace = false

# Windows のバッチファイルは CRLF
[*.{bat,cmd}]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[gradlew]
end_of_line = lf
